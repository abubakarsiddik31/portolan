      "params": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "returns": {
        "type": "object",
        "properties": {
          "subtotal": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "qty": {
                  "type": "integer"
                },
                "total": {
                  "type": "string"
                }
              },
              "required": ["name", "qty", "total"],
              "additionalProperties": false
            }
          }
        },
        "required": ["subtotal", "items"],
