{
  "name": "@portolan/server",
  "version": "0.1.0",
  "description": "HTTP and MCP server for Portolan maps.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abubakarsiddik31/portolan.git",
    "directory": "packages/portolan-server"
  },
  "homepage": "https://github.com/abubakarsiddik31/portolan#readme",
  "bugs": {
    "url": "https://github.com/abubakarsiddik31/portolan/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -b",
    "start": "node dist/start.js",
    "mcp": "node dist/mcp-stdio.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@portolan/protocol": "workspace:*",
    "@portolan/runtime": "workspace:*",
    "@portolan/substrate": "workspace:*",
    "better-sqlite3": "13.0.3",
    "fastify": "5.12.8",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0"
  }
}
