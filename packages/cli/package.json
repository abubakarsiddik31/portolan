{
  "name": "@abubakarsiddiik/portolan",
  "version": "0.1.0",
  "description": "The portolan command: init, serve, compile, verify, export-skills, bench, doctor.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "portolan": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abubakarsiddik31/portolan.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/abubakarsiddik31/portolan#readme",
  "bugs": {
    "url": "https://github.com/abubakarsiddik31/portolan/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -b",
    "doctor": "node dist/bin.js doctor"
  },
  "dependencies": {
    "@abubakarsiddiik/compiler": "workspace:*",
    "@abubakarsiddiik/protocol": "workspace:*",
    "@abubakarsiddiik/runtime": "workspace:*",
    "@abubakarsiddiik/server": "workspace:*",
    "@abubakarsiddiik/skills": "workspace:*",
    "@abubakarsiddiik/substrate": "workspace:*",
    "@abubakarsiddiik/qa": "workspace:*"
  },
  "devDependencies": {
    "fastify": "5.12.8",
    "@modelcontextprotocol/sdk": "1.32.2"
  }
}
