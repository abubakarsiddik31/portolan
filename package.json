{
  "name": "portolan",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -b --pretty false",
    "clean": "tsc -b --clean && rm -rf coverage",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:providers": "vitest run packages/model/src/providers.test.ts",
    "fixtures:store": "pnpm --filter @portolan/bench run fixtures:store",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.test.json --pretty false",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "commitlint": "commitlint --from origin/main --to HEAD --verbose",
    "package:check": "node scripts/verify-packages.mjs",
    "package:check:tarballs": "node scripts/verify-packages.mjs --tarballs",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "release": "pnpm build && changeset publish",
    "release:dry-run": "node scripts/release-dry-run.mjs",
    "docs:build": "node scripts/build-docs.mjs",
    "licenses:check": "node scripts/check-licenses.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "agent-browser",
      "better-sqlite3",
      "esbuild"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@commitlint/lint": "21.2.4",
    "@commitlint/load": "21.2.4",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.1.0",
    "marked": "^18.1.3",
    "typescript": "5.9.3",
    "vitest": "5.1.0",
    "yaml": "2.9.1"
  }
}
