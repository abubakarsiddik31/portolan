      },
      "from": ["catalog", "product", "cart"],
      "to": ["cart"],
      "post": [
        {
          "kind": "state",
          "state": "cart"
        }
      ],
      "effect": "read",
      "impls": [
        {
          "tier": "url",
          "route": "/cart",
          "extract": {
            "kind": "composite",
            "fields": {
              "subtotal": {
                "test_id": "cart-subtotal"
              }
            },
            "rows": {
              "as": "items",
              "container": {
                "test_id": "cart-table"
              },
              "row": {
                "test_id": "cart-row"
              },
              "cols": {
                "name": {
                  "role": "link"
                },
                "qty": {
                  "role": "spinbutton",
                  "attr": "value"
                },
                "total": {
                  "role": "cell",
                  "ordinal": 3
                }
              }
            }
          }
        }
      ],
      "status": "verified"
    },
    {
      "name": "open_checkout",
      "version": 1,
