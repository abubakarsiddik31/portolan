    {
      "name": "get_product_api",
      "version": 1,
      "summary": "Read a product through the JSON API, binding its name.",
      "params": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["product_id"],
        "additionalProperties": false
      },
      "returns": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "price_cents": {
            "type": "integer"
          },
          "url": {
            "type": "string"
          }
        },
        "required": ["id", "name", "price_cents", "url"],
        "additionalProperties": false
      },
      "from": ["catalog", "results", "product"],
      "to": ["catalog", "results", "product"],
      "post": [],
      "effect": "read",
      "impls": [
        {
          "tier": "http",
          "steps": [
            {
              "method": "GET",
              "url": "/api/products/{product_id}",
              "bind": {
                "product_name": "name"
              }
            },
            {
              "method": "GET",
              "url": "/api/products?q={product_name}"
            }
          ],
          "extract": {
            "kind": "json",
            "path": "products.0"
          }
        }
      ],
      "status": "verified"
    }
