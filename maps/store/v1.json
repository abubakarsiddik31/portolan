      "status": "verified"
    },
    {
      "name": "checkout",
      "version": 1,
      "summary": "Place an order.",
      "params": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "email": {
            "type": "string",
            "minLength": 3
          },
          "address": {
            "type": "string",
            "minLength": 1
          },
          "city": {
            "type": "string",
            "minLength": 1
          },
          "postal": {
            "type": "string",
            "minLength": 1
          },
          "card": {
            "type": "string",
            "minLength": 12
          }
        },
        "required": ["name", "email", "address", "city", "postal", "card"],
        "additionalProperties": false
      },
      "returns": {
        "type": "object",
        "properties": {
          "order_id": {
            "type": "string"
          }
        },
        "required": ["order_id"],
        "additionalProperties": false
      },
      "from": ["checkout"],
      "to": ["order"],
      "post": [
        {
          "kind": "state",
          "state": "order"
        },
        {
          "kind": "url",
          "pattern": "^/orders/ord_"
        }
      ],
      "effect": "irreversible",
      "confirm": true,
      "impls": [
        {
          "tier": "ui",
          "steps": [
            {
              "do": "fill",
              "target": {
                "label": "Full name"
              },
              "value": "{name}"
            },
            {
              "do": "fill",
              "target": {
                "label": "Email"
              },
              "value": "{email}"
            },
            {
              "do": "fill",
              "target": {
                "label": "Address"
              },
              "value": "{address}"
            },
            {
              "do": "fill",
              "target": {
                "label": "City"
              },
              "value": "{city}"
            },
            {
              "do": "fill",
              "target": {
                "label": "Postal code"
              },
              "value": "{postal}"
            },
            {
              "do": "fill",
              "target": {
                "label": "Card number"
              },
              "value": "{card}"
            },
            {
              "do": "click",
              "target": {
                "role": "button",
                "name": "Place order"
              }
            },
            {
              "do": "await_state",
              "state": "order"
            }
          ],
          "extract": {
            "kind": "fields",
            "fields": {
              "order_id": {
                "test_id": "order-id",
                "attr": "text"
              }
            }
          }
        }
      ],
      "status": "verified"
    },
