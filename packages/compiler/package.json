  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abubakarsiddik31/portolan.git",
    "directory": "packages/compiler"
  },
  "homepage": "https://github.com/abubakarsiddik31/portolan#readme",
  "bugs": {
    "url": "https://github.com/abubakarsiddik31/portolan/issues"
